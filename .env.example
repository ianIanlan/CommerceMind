# LLM 服务
ANTHROPIC_API_KEY=replace_with_your_key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_BASE_URL=https://your-compatible-endpoint.example
# 可选值：anthropic / responses
LLM_API_FORMAT=anthropic
# true 时跳过 LLM，仅使用本地意图与确定性业务回复。
DISABLE_LLM=false
# 当前字符向量消融效果较差，默认关闭；仅实验时开启。
INTENT_EMBEDDING_ENABLED=false

# demo：兼容前端传 user_id；signed_token：忽略客户端 user_id，只信任 HMAC Bearer Token。
AUTH_MODE=demo
# AUTH_SECRET=replace_with_a_long_random_secret

# 基础设施
# 无 Docker/Redis/Chroma 时设为 true；订单和退款仍写入 SQLite。
LOCAL_DEMO_MODE=false
REDIS_PASSWORD=commercemind123
REDIS_URL=redis://:commercemind123@redis:6379/0
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=/app/data/chroma

# CommerceMind
COMMERCE_DB_PATH=/app/data/commerce.sqlite3
# 生产设置后优先于 COMMERCE_DB_PATH
# DATABASE_URL=postgresql://commercemind:change_me@postgres:5432/commercemind
COMMERCEMIND_SKILLS_DIR=/app/skills
EVAL_BASELINE_PATH=/app/data/eval/baseline.json

# 运行参数
LOG_LEVEL=INFO
MONITOR_INTERVAL=10
